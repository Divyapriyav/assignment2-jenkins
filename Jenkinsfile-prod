pipeline {
    agent {
        label 'prod'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to Prod') {
            steps {
                sh '''
                mkdir -p /home/ubuntu/prod-app
                cp -r * /home/ubuntu/prod-app/
                '''
            }
        }
    }
}
`
